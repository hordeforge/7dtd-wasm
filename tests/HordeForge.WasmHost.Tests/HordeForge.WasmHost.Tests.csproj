<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/HordeForge.WasmHost/HordeForge.WasmHost.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../fixtures/*.wasm" CopyToOutputDirectory="PreserveNewest" Link="fixtures/%(Filename)%(Extension)" />
    <None Include="../fixtures/*.toml" CopyToOutputDirectory="PreserveNewest" Link="fixtures/%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- GuestRateLimiter, SenseRecordPicker, WorldTime, and
       WasmSettingsProvider are bridge code with no game references; link the
       files so the caps, the sense record pick, the world-clock conversion,
       and the shared settings file cache are covered on net8. GameLogShim
       stands in for the game's global Log. The net48 bridge itself builds
       against the dedicated install (make bridge), not here. -->
  <ItemGroup>
    <Compile Include="../../src/GameBridge/Bridge/GuestRateLimiter.cs" Link="GuestRateLimiter.cs" />
    <Compile Include="../../src/GameBridge/Bridge/SenseRecordPicker.cs" Link="SenseRecordPicker.cs" />
    <Compile Include="../../src/GameBridge/Bridge/WorldTime.cs" Link="WorldTime.cs" />
    <Compile Include="../../src/GameBridge/Bridge/WasmSettingsProvider.cs" Link="WasmSettingsProvider.cs" />
  </ItemGroup>

</Project>
