bin/
obj/
.vs/
*.user
*.suo
artifacts/
dist/
captures/
server-data/
__pycache__/
*.pyc
*.lock
!samples/Cargo.lock
samples/target/
# Guest build outputs never belong next to their sources; the build
# pipeline stages them under samples/target/ (see Makefile boss targets).
samples/guest-boss/*.wasm
samples/guest-boss-zig/*.wasm
.rustup/
# The in-project Rust toolchain at the workspace root only; the tracked
# samples/.cargo/config.toml holds the guest link flags (it is not the
# toolchain, and a repo-wide ".cargo/" would also exclude it).
/.cargo/
tools/targetcheck/bin/
tools/targetcheck/obj/

# Scratch: every temporary, experimental, or bisect file lives here and is
# never committed. See the org REPOSITORY_STANDARDS.md.
.scratch/
.scratch_*
