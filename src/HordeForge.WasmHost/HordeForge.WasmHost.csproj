<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>HordeForge.WasmHost</RootNamespace>
    <AssemblyName>HordeForge.WasmHost</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Pack metadata: the library is the publishable artifact of this
         repository; keep Version aligned with CHANGELOG.md. -->
    <PackageId>HordeForge.WasmHost</PackageId>
    <Version>0.4.0</Version>
    <Authors>hordeforge</Authors>
    <Description>Embeddable WebAssembly mod host for 7 Days to Die dedicated servers: untrusted wasm32-wasip1 guest mods under fuel, memory, and module size limits on an embedded Wasmtime engine.</Description>
    <PackageTags>7dtd;wasm;wasmtime;sandbox;modding;mod-host</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <!-- The README travels inside the package: nuget.org renders it on the
         listing, and it is the only place the install and usage story is
         written. Without it "dotnet pack" warns and the listing is bare. -->
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/hordeforge/7dtd-wasm</RepositoryUrl>
    <!-- Without the type the listing shows a bare URL instead of a link to
         the source tree, which is where the version history and the issues
         for a package nobody has published to a public feed yet live. -->
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Wasmtime" Version="48.0.2" />
  </ItemGroup>

  <!-- Wasmtime is Apache-2.0 WITH LLVM-exception, so the package carries the
       attribution for it and the rest of the shipped closure. LICENSE
       travels with the notices because they link to it ("see
       [LICENSE](LICENSE)"), and a package whose notices point at a file it
       does not contain leaves a consumer reading our terms through a dead
       reference. -->
  <ItemGroup>
    <None Include="../../THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
