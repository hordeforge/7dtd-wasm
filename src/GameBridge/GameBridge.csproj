<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>HordeForge.GameBridge</RootNamespace>
    <AssemblyName>HordeForge.GameBridge</AssemblyName>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../HordeForge.WasmHost/HordeForge.WasmHost.csproj" />
  </ItemGroup>

  <!--
    Game references come from the installed dedicated server. Pass
    -p:GAME_DIR=/path/to/7 Days to Die Dedicated Server at build time
    (the Makefile does this). Targets are validated by tools/targetcheck.
  -->
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GAME_DIR)/7DaysToDieServer_Data/Managed/Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GAME_DIR)/7DaysToDieServer_Data/Managed/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="LogLibrary">
      <HintPath>$(GAME_DIR)/7DaysToDieServer_Data/Managed/LogLibrary.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(GAME_DIR)/Mods/0_TFP_Harmony/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
