<Project>

  <!-- Analyzer and warning posture for every project in this repo
       (host library, tests, targetcheck, net48 GameBridge).
       The tree builds warning-free, so warnings are treated as
       defects: a new compiler or analyzer diagnostic fails the build
       instead of scrolling by. Opting out is a per-project,
       rule-scoped decision, never silence by default. -->
  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <!-- Promote the C# style rules in .editorconfig from editor
         suggestions to build diagnostics. Without this the IDE analyzers
         run but their severity stays at suggestion, so a rule set there
         that a developer silently ignores is the only thing a CI run
         sees. The dotnet_diagnostic block in .editorconfig names the
         rules this promotes; the tree passes all of them, and
         TreatWarningsAsErrors turns a new one into a build failure. -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Default ("latest") analysis level: the tree passes it today.
         Stepping up to latest-recommended is a later pass; it currently
         surfaces ~120 findings across CA1051/CA1510/CA1859 and friends,
         which is code-review territory, not a config flip. -->
    <AnalysisLevel>latest</AnalysisLevel>
  </PropertyGroup>

  <!-- Commit a NuGet lock file (packages.lock.json) per project so every
       resolved package carries its SHA512 content hash: restores verify
       integrity and consumers get an exact inventory of what shipped. -->
  <PropertyGroup>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- A locked restore is the one that reads the committed lock file as
         the answer instead of re-resolving and rewriting it. Without it a
         build can pull a newer patch of a package whose manifest nobody
         changed, and the next person to commit the regenerated lock file
         blesses that bump by accident. CI sets CI=true, so every restore a
         pipeline runs is locked and a manifest that moved without its lock
         file fails there by name. A developer build stays unlocked, because
         "make locks" is how a deliberate bump regenerates the file; the
         Makefile passes RestoreLockedMode on the command line for the gates
         that must be locked on a developer machine too, and a command-line
         property overrides this one. -->
    <RestoreLockedMode Condition="'$(CI)' != ''">true</RestoreLockedMode>
  </PropertyGroup>

  <!-- Reproducibility. "latest" here is a floating language version: the same
       source compiled by a newer SDK band can take different overload
       resolution paths and produce different IL, so the version is pinned
       to the one this tree is written against. It lives here, not in the
       four manifests, so the floor cannot disagree with itself. -->
  <PropertyGroup>
    <LangVersion>12.0</LangVersion>
  </PropertyGroup>

  <!-- Build-path independence. Without ContinuousIntegrationBuild the SDK
       writes the absolute checkout path into the PDB and the assembly's
       debug metadata, so the same source built in /home/ci and in
       /builds/x ships different bytes. Setting it normalizes those paths
       (DeterministicSourcePaths) and makes the SDK honor SOURCE_DATE_EPOCH
       for the embedded timestamps. GitHub Actions sets CI=true; set it
       locally, or pass -p:ContinuousIntegrationBuild=true, to reproduce a
       release build. -->
  <PropertyGroup>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' != ''">true</ContinuousIntegrationBuild>
    <DeterministicSourcePaths Condition="'$(ContinuousIntegrationBuild)' == 'true'">true</DeterministicSourcePaths>
  </PropertyGroup>

</Project>
